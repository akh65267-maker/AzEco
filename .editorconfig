root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,bicep,bicepparam,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Modern C# style
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion

# Naming
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# CA1848 (use LoggerMessage delegates) is the right call for hot paths but
# noisy for startup code. Warn, don't fail.
dotnet_diagnostic.CA1848.severity = suggestion
# We use records/DTOs across boundaries; CA1812 misfires on them.
dotnet_diagnostic.CA1812.severity = none
# Logging message templates must be constant — this one genuinely matters.
dotnet_diagnostic.CA2254.severity = warning

[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core migrations are generated by `dotnet ef`, not written by hand, and regenerating
# them reintroduces whatever style the tool emits. Marking them generated is the narrow
# fix; relaxing TreatWarningsAsErrors repo-wide to accommodate them would be the wrong
# one, since hand-written code is where those rules actually earn their keep.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
